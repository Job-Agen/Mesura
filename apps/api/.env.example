# PostgreSQL — any Postgres works; on Neon use the pooled URL for DATABASE_URL
# and the direct (non-pooled) URL for DIRECT_URL (used by migrations).
DATABASE_URL="postgresql://mesura:mesura@localhost:5432/mesura?schema=public"
DIRECT_URL="postgresql://mesura:mesura@localhost:5432/mesura?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-long-random-secret-of-32-plus-chars"
JWT_EXPIRES_IN="7d"

PORT=3000
# Comma-separated list; leave empty to allow all origins in development.
CORS_ORIGINS=""
# Set to true behind a reverse proxy (Vercel, load balancer) so rate limits use the real client IP.
TRUST_PROXY=false

# Sandbox — enables /sandbox/* endpoints. Must be false against real providers.
SANDBOX_MODE=true
# Seconds after which the fake Mobile Money payment auto-confirms (0 = manual only).
SANDBOX_FUNDING_AUTO_CONFIRM_SECONDS=10

# Illustrative pricing placeholder: 500 bps = 5% (15,000 FCFA → 750 FCFA fee).
SERVICE_FEE_BPS=500
# Cards per person (identity + Mobile Money number) funded without the fee; 0 = none
FREE_CARDS_PER_PERSON=0
# Key for identity/phone fingerprints (>= 32 chars). Empty = derived from JWT_SECRET. Never change it once set.
FINGERPRINT_SECRET=
# Pending Mobile Money requests expire after this many minutes.
FUNDING_EXPIRY_MINUTES=15

# FedaPay (real Mobile Money). Empty = simulated. sk_sandbox_... = FedaPay test mode.
# A sk_live_... key moves real money and is refused unless FEDAPAY_ALLOW_LIVE=true.
FEDAPAY_SECRET_KEY=
FEDAPAY_ALLOW_LIVE=false
# Send refunds of unspent card balances with FedaPay payouts (enabled per account by FedaPay's support,
# support@fedapay.com). false = refunds are simulated. Required with a sk_live_ key.
FEDAPAY_PAYOUTS_ENABLED=false
