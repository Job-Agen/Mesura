// Mesura — sandbox data model
//
// Money: every amount column is an Int holding MINOR units of `currency`.
// XOF has no minor unit, so 15000 = 15,000 FCFA. No floating point.
//
// Sensitive data that is intentionally NOT modelled: card PAN, CVV,
// Mobile Money PIN, identity document scans.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum CardStatus {
  PENDING_FUNDING
  ACTIVE
  FROZEN
  EXPIRED
  TERMINATED
}

enum TerminationReason {
  USER_REQUESTED
  USAGE_LIMIT_REACHED
}

enum FundingStatus {
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
}

enum TransactionStatus {
  PENDING
  APPROVED
  BLOCKED
  FAILED
}

enum DeclineReason {
  CARD_NOT_ACTIVE
  CARD_EXPIRED
  AMOUNT_LIMIT_EXCEEDED
  TRANSACTION_LIMIT_REACHED
  MERCHANT_NOT_ALLOWED
}

enum RefundStatus {
  PENDING
  SENT
  FAILED
  ACTION_REQUIRED
}

enum MobileMoneyProvider {
  TMONEY
  FLOOZ
  MOOV_MONEY
}

enum Currency {
  XOF
}

model User {
  id                 String                  @id @default(cuid())
  email              String                  @unique
  name               String
  phone              String?
  passwordHash       String
  /// When the user accepted the terms of use at sign-up (null for accounts created before they existed).
  termsAcceptedAt    DateTime?
  /// Set once the address is confirmed with the 6-digit code sent at sign-up.
  emailVerifiedAt    DateTime?
  /// Part of every session token; raised when the password changes, which signs out every device.
  sessionVersion     Int                     @default(0)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  kycProfile         KycProfile?
  cards              Card[]
  fundings           Funding[]
  passwordResetCodes PasswordResetCode[]
  emailCodes         EmailVerificationCode[]
  fingerprints       Fingerprint[]
}

enum FingerprintKind {
  IDENTITY
  PHONE
}

/// Irreversible keyed hash (HMAC-SHA256) of a verified identity or a Mobile Money number.
/// It outlives account deletion (userId is set to null) so that deleting and re-creating an
/// account cannot reset per-person limits such as free cards. It cannot be turned back into
/// the name, date of birth or phone number it was computed from.
model Fingerprint {
  hash          String          @id
  kind          FingerprintKind
  /// Live account currently holding it; null once that account is deleted.
  userId        String?
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  freeCardsUsed Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
}

/// One-time code e-mailed for "forgot password". Only a hash of the code is stored.
model PasswordResetCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Code e-mailed to confirm a new account's address (hashed, like password reset codes).
model EmailVerificationCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model KycProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            KycStatus @default(NOT_STARTED)
  firstName         String?
  lastName          String?
  dateOfBirth       DateTime? @db.Date
  country           String?
  /// Reference returned by the KYC provider (sandbox: fake).
  providerReference String?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Merchant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  iconUrl   String?
  createdAt DateTime     @default(now())
  policies  CardPolicy[]
}

model Card {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  label             String
  /// Issuer-side identifier. Null until the card is issued after funding.
  providerCardId    String?            @unique
  /// Only the last 4 digits are ever stored.
  last4             String?
  status            CardStatus         @default(PENDING_FUNDING)
  terminationReason TerminationReason?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  activatedAt       DateTime?
  /// Mirrors policy.expiresAt (the policy is the source of truth).
  expiresAt         DateTime
  policy            CardPolicy?
  fundings          Funding[]
  transactions      Transaction[]
  refund            Refund?

  @@index([userId, createdAt])
}

model CardPolicy {
  id                      String    @id @default(cuid())
  cardId                  String    @unique
  card                    Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  maxAmount               Int
  spentAmount             Int       @default(0)
  currency                Currency  @default(XOF)
  /// Null = unlimited payments until expiration.
  maxTransactionCount     Int?
  currentTransactionCount Int       @default(0)
  /// Merchant slug, null = usable anywhere. Sandbox-only enforcement.
  merchantRestriction     String?
  merchant                Merchant? @relation(fields: [merchantRestriction], references: [slug])
  /// Chosen lifetime; expiresAt is recomputed from it at activation.
  durationMinutes         Int
  expiresAt               DateTime
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model Funding {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId            String
  card              Card                @relation(fields: [cardId], references: [id], onDelete: Cascade)
  provider          MobileMoneyProvider
  /// Reference returned by the payment provider (sandbox: fake).
  providerReference String              @unique
  phone             String
  amount            Int
  fee               Int
  /// The fee was waived because the person still had a free card (see Fingerprint).
  freeCard          Boolean             @default(false)
  total             Int
  currency          Currency            @default(XOF)
  status            FundingStatus       @default(PENDING)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  confirmedAt       DateTime?

  @@index([cardId])
  @@index([userId, createdAt])
}

/// Unspent balance sent back to Mobile Money once the card has ended. At most one per card.
model Refund {
  id                String              @id @default(cuid())
  cardId            String              @unique
  card              Card                @relation(fields: [cardId], references: [id], onDelete: Cascade)
  amount            Int
  currency          Currency            @default(XOF)
  provider          MobileMoneyProvider
  /// Null while the user has not given a number refunds can be sent to (ACTION_REQUIRED).
  phone             String?
  status            RefundStatus
  /// Payout reference at the payment provider; a new one is set on each attempt.
  providerReference String?             @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  sentAt            DateTime?

  @@index([status])
}

model Transaction {
  id            String            @id @default(cuid())
  cardId        String
  card          Card              @relation(fields: [cardId], references: [id], onDelete: Cascade)
  /// Normalised merchant identifier as presented by the merchant.
  merchant      String
  merchantName  String
  amount        Int
  currency      Currency          @default(XOF)
  status        TransactionStatus
  declineReason DeclineReason?
  createdAt     DateTime          @default(now())

  @@index([cardId, createdAt])
}

/// Sign-up from the public pages, before the public launch: the waitlist (/liste-attente) or the
/// tester page (/testeurs), which also asks for the Gmail address Google Play needs to invite a tester.
model WaitlistEntry {
  id        String   @id @default(cuid())
  name      String
  /// WhatsApp number, normalized to +228XXXXXXXX; one entry per number.
  phone     String   @unique
  /// Services the person pays online today (labels from the page's checkboxes).
  services  String[]
  /// Set when the person signed up as a tester.
  gmail     String?
  tester    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Feedback sent from the public tester page (/testeurs).
model TesterFeedback {
  id        String   @id @default(cuid())
  name      String?
  /// Optional WhatsApp number or e-mail to answer the tester.
  contact   String?
  /// 1 to 5.
  rating    Int?
  message   String
  createdAt DateTime @default(now())
}
