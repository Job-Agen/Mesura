{
  "expo": {
    "name": "Mesura",
    "slug": "mesura-sandbox",
    "scheme": "mesura",
    "version": "0.7.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F4EE",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "africa.mesura.sandbox",
      "buildNumber": "7"
    },
    "android": {
      "package": "africa.mesura.sandbox",
      "adaptiveIcon": {
        "backgroundColor": "#073D31",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 11
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        { "faceIDPermission": "Mesura utilise Face ID pour afficher les informations de vos cartes." }
      ],
      "./plugins/with-sandbox-cleartext",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#073D31"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
