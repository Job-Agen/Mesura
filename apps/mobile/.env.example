# URL of the Mesura API as reachable from the device/emulator:
#  - iOS simulator / web:      http://localhost:3000
#  - Android emulator:         http://10.0.2.2:3000
#  - Physical phone (Expo Go): http://<your-computer-LAN-IP>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Show the API server picker on the login screen in a release (sandbox) build.
# Always shown in development; leave false for builds sent to testers.
EXPO_PUBLIC_SERVER_PICKER=false
